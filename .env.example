# Copy this file to .env and adjust. Never put secrets in either file.

# ollama (local LLM, default) | local (rule-based, no LLM) | foundry (Azure)
AGENT_MODE=ollama
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
KNOWLEDGE_BASE_PATH=data/knowledge_base.txt
MAX_HISTORY_MESSAGES=50

# Ollama (AGENT_MODE=ollama). No credentials needed.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.2
# qwen3:4b always reasons first; true keeps that reasoning out of replies.
OLLAMA_THINK=true
# Context window in tokens. Ollama's 4096 default overflows after a few turns.
OLLAMA_NUM_CTX=8192
OLLAMA_FALLBACK_TO_RULES=true

# Required only when AGENT_MODE=foundry
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_MODEL_NAME=<model-deployment-name>
FOUNDRY_AGENT_NAME=developer-support-agent
FOUNDRY_DELETE_AGENT_ON_EXIT=false

# REST API (python -m app.api). Uses AGENT_MODE above: ollama or local only.
# No authentication: keep API_HOST on 127.0.0.1 (local development only).
API_HOST=127.0.0.1
API_PORT=8000
# Exact browser origins, comma-separated. Wildcards (*) are rejected.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_SESSION_TTL_SECONDS=1800
API_MAX_SESSIONS=20
# Agent turns that may run at once. Ollama on a CPU is best served one at a time.
API_MAX_CONCURRENT_TURNS=1
# How long a turn waits for a free slot before the API returns 503.
API_QUEUE_TIMEOUT_SECONDS=300
